# Example environment configuration for the Hugging Face -> MinIO mirror job
# running behind a corporate proxy with Kerberos authentication.
# Copy to `.env` and adjust secrets before running `proxy/mirror/mirror_hf_to_minio.py`.

# --- Hugging Face ---
HF_TOKEN=hf_xxx_replace_me
HF_REPOS=org/model-one,org/model-two
# Optional revisions aligned with HF_REPOS (leave blank to use repo default)
HF_REVISIONS=main,
LICENSE_ALLOWLIST=apache-2.0,mit
REPO_DENYLIST=
FILE_DENYLIST=
HF_ENDPOINT=https://huggingface.co
HF_HTTP_TIMEOUT=30
DOWNLOAD_CHUNK_SIZE=1048576

# --- Output paths ---
DATA_DIR=/workspace/mirror-data
DRY_RUN=false

# --- MinIO / S3 destination ---
MINIO_ENDPOINT=https://minio.internal.example.com:9000
MINIO_BUCKET=models
MINIO_PREFIX=mirrors/hf
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minio-sync
MINIO_SECRET_KEY=super-secret-access-key
MINIO_SECURE=true

# --- Proxy & Kerberos (required inside OpenShift pipeline) ---
HTTP_PROXY=http://abproxy.example.com:8080
HTTPS_PROXY=http://abproxy.example.com:8080
NO_PROXY=localhost,127.0.0.1,minio,*.svc
# Path to the trusted proxy certificate bundle (.pem)
PROXY_CA_FILE=/etc/pki/tls/certs/proxy-ca.pem
# Extra headers for the corporate proxy (semicolon separated)
PROXY_HEADERS=Proxy-Connection: Keep-Alive; X-Forwarded-Proto: https
# Kerberos/Negotiate configuration for requests-kerberos
PROXY_KERBEROS=true
PROXY_KERBEROS_PRINCIPAL=svc_mirror@EXAMPLE.COM
PROXY_KERBEROS_SERVICE=HTTP/abproxy.example.com
PROXY_KERBEROS_MUTUAL=required
